{
  "name": "nottennapod-web",
  "version": "0.1.0",
  "private": true,
  "description": "NotTennaPod's browser client: AntennaPod 3.12.1 in a browser, synced through NotTennaPod-Server.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "strings": "node scripts/strings.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "e2e": "playwright test",
    "install-into-server": "node scripts/install-into-server.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "journeys": "playwright test -c playwright.journeys.config.ts",
    "layout": "playwright test -c playwright.layout.config.ts",
    "player": "playwright test -c playwright.player.config.ts",
    "acceptance": "playwright test -c playwright.acceptance.config.ts",
    "actor": "node e2e/acceptance/actor.ts"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "preact": "11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2"
  }
}
